    {
      "id": "t4",
      "name": "Buscar en Qdrant (Top-K + Min Score)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:6333/collections/{{ $('Parámetros RAG').first().json.coleccion }}/points/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vector: $json.embeddings.float[0], limit: $('Parámetros RAG').first().json.top_k, score_threshold: $('Parámetros RAG').first().json.min_score, with_payload: true }) }}",
        "options": {}
      }
    },
    {
      "id": "t5",
      "name": "Formatear fragmentos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Convierte los hits de Qdrant en un texto de fragmentos numerados con su fuente y score.\nconst p = $('Parámetros RAG').first().json;\nconst hits = $json.result || [];\nif (!hits.length) {\n  return [{ json: { resultado: `SIN_RESULTADOS: ningún fragmento superó el Minimum Score (${p.min_score}). Respondé \"No cuento con ese dato.\"` } }];\n}\nconst bloques = hits.map((h, i) => {\n  const md = (h.payload && h.payload.metadata) || {};\n  const texto = (h.payload && h.payload.content) || '';\n  return `[Fragmento ${i + 1}] fuente: ${md.source || '?'} | sección: ${md.section || '-'} | score: ${h.score.toFixed(3)}\\n${texto}`;\n});\nreturn [{ json: { resultado: bloques.join('\\n\\n---\\n\\n') } }];\n"
      }
    }
  ],
