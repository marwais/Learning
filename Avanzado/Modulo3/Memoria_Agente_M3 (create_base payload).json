              {
                "name": "Pendiente"
              },
              {
                "name": "En Revisión"
              },
              {
                "name": "Cerrado"
              }
            ]
          }
        },
        {
          "name": "Datos Clave",
          "type": "multilineText"
        },
        {
          "name": "Mensajes",
          "type": "number",
          "options": {
            "precision": 0
          }
        }
      ]
    }
  ]
}