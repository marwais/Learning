  {
   "id": "41a10a9f-d637-4280-aafe-3caba26a12d4",
   "name": "Filtrar futuros y listar",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    480,
    0
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const NL = String.fromCharCode(10);\nconst now = new Date();\nconst today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\nfunction parseF(f){\n  f = String(f||'').trim();\n  let m = f.match(/^([0-9]{1,2})[/]([0-9]{1,2})[/]([0-9]{4})$/);\n  if(m) return new Date(+m[3], +m[2]-1, +m[1]);\n  m = f.match(/^([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})$/);\n  if(m) return new Date(+m[1], +m[2]-1, +m[3]);\n  const d = new Date(f); return isNaN(d) ? null : new Date(d.getFullYear(), d.getMonth(), d.getDate());\n}\nconst rows = $input.all().map(i => i.json).filter(r => r && r.Nombre);\nconst fut = rows.filter(r => { const d = parseF(r.Fecha); return d && d >= today; })\n                .sort((a,b) => parseF(a.Fecha) - parseF(b.Fecha));\nconst lista = fut.map(r => '- #' + r.ID + ' | ' + r.Fecha + ' ' + r.Hora + ' - ' + r.Motivo + ' (' + r.Estado + ')').join(NL);\nconst mensaje = fut.length ? ('Turnos pendientes:' + NL + lista) : 'No tenes turnos pendientes.';\nconst traceId = $('Cuando el Manager lo llama').first().json.traceId || '';\nreturn [{ json: { traceId, status: 'success', data: { cantidad: fut.length, turnos: fut, mensaje: mensaje } } }];"
   }
  }
 ],
