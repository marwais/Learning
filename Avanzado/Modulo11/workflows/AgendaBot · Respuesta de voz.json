  {
   "id": "bd58d11c-f232-4eba-9454-74c8314c2f6a",
   "name": "Descartar audio (compliance)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    680,
    300
   ],
   "parameters": {
    "jsCode": "// Compliance: el audio del paciente y el sintetizado no se conservan.\n// Se devuelve solo metadata (sin binario); además el workflow no guarda ejecuciones,\n// así que n8n borra los archivos temporales de la ejecución al terminar.\nreturn $input.all().map(i => ({ json: { enviado: true, chat_id: i.json.result?.chat?.id ?? null, audio_destruido: true } }));"
   }
  },
  {
   "id": "c8f06f3c-36b4-4f86-8ac0-cb2be1218396",
   "name": "Nota",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -40,
    0
   ],
   "parameters": {
    "width": 920,
    "height": 240,
    "content": "## AgendaBot · Respuesta de voz: privacidad de los audios\nSintetiza la respuesta (máx. 200 caracteres) con ElevenLabs, la manda como nota de voz y **descarta el binario**: devuelve solo metadatos. Este workflow **no guarda ninguna ejecución** (ni con éxito ni con error), así que el audio solo existe en memoria durante el envío. Lo mismo hace el Canal Telegram con la nota de voz del paciente (devolución de la P6).\n\n**Voz uniforme**: estabilidad 0,80 y similitud 0,90 (con 0,55 la misma voz sonaba distinta entre frases cortas y largas)."
   }
  }
 ],
